{
  "name": "github-proxy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Authenticated web proxy with a Turkish browser interface",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.mjs",
    "setup": "node scripts/setup.mjs",
    "test": "node --test test/*.test.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@mercuryworkshop/bare-mux": "2.1.9",
    "@mercuryworkshop/epoxy-transport": "2.1.28",
    "@mercuryworkshop/scramjet": "1.1.0",
    "@mercuryworkshop/wisp-js": "0.5.0",
    "express": "5.3.0",
    "ipaddr.js": "2.5.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "ws": "8.22.0"
  },
  "license": "AGPL-3.0-only"
}
